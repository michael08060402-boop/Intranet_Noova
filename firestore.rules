rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function sesionIniciada() {
      return request.auth != null;
    }

    function rutaPerfil(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function esPropietario(uid) {
      return sesionIniciada() && request.auth.uid == uid;
    }

    function correoVerificado() {
      return sesionIniciada() && request.auth.token.email_verified == true;
    }

    // `estado` y `foto` son opcionales: los perfiles anteriores a esos campos siguen siendo válidos.
    function perfilValido(datos) {
      return datos.keys().hasAll(['nombre', 'correo', 'rol', 'plan', 'creadoEn'])
        && datos.keys().hasOnly(['nombre', 'correo', 'rol', 'plan', 'creadoEn', 'estado', 'foto'])
        && datos.nombre is string
        && datos.nombre.size() > 0
        && datos.nombre.size() <= 120
        && datos.correo is string
        && datos.correo.size() > 0
        && datos.correo.size() <= 320
        && datos.rol in ['alumno', 'admin']
        && datos.plan in ['gratis', 'premium']
        && datos.get('estado', 'activo') in ['activo', 'suspendido']
        && (!('foto' in datos) || (datos.foto is string && datos.foto.size() <= 40000 && datos.foto.matches('^data:image/jpeg;base64,.*')))
        && datos.creadoEn is timestamp;
    }

    function perfilActual() {
      return get(rutaPerfil(request.auth.uid)).data;
    }

    // Perfil existente, válido y no suspendido de quien tiene el correo verificado.
    function perfilActivo() {
      return correoVerificado()
        && exists(rutaPerfil(request.auth.uid))
        && perfilValido(perfilActual())
        && perfilActual().get('estado', 'activo') == 'activo';
    }

    function esAlumnoVerificado() {
      return perfilActivo() && perfilActual().rol == 'alumno';
    }

    function esAdministrador() {
      return perfilActivo() && perfilActual().rol == 'admin';
    }

    function tienePlanPremium() {
      return esAlumnoVerificado() && perfilActual().plan == 'premium';
    }

    function textoValido(texto, minimo, maximo) {
      return texto is string
        && texto.size() >= minimo
        && texto.size() <= maximo;
    }

    function idValido(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,120}$');
    }

    function categoriaActiva(categoriaId) {
      let ruta = /databases/$(database)/documents/categorias/$(categoriaId);
      return exists(ruta) && get(ruta).data.activa == true;
    }

    function cursoPublicado(cursoId) {
      let ruta = /databases/$(database)/documents/cursos/$(cursoId);
      return exists(ruta) && get(ruta).data.publicado == true;
    }

    function rutaCurso(cursoId) {
      return /databases/$(database)/documents/cursos/$(cursoId);
    }

    function rutaClase(cursoId, claseId) {
      return /databases/$(database)/documents/cursos/$(cursoId)/clases/$(claseId);
    }

    function clasePublicada(cursoId, claseId) {
      return exists(rutaClase(cursoId, claseId))
        && get(rutaClase(cursoId, claseId)).data.publicado == true;
    }

    function categoriaValida(datos) {
      return datos.keys().hasAll(['nombre', 'descripcion', 'activa', 'creadoEn', 'actualizadoEn'])
        && datos.keys().hasOnly(['nombre', 'descripcion', 'activa', 'creadoEn', 'actualizadoEn'])
        && textoValido(datos.nombre, 2, 80)
        && textoValido(datos.descripcion, 0, 500)
        && datos.activa is bool
        && datos.creadoEn is timestamp
        && datos.actualizadoEn == request.time;
    }

    function portadaValida(datos, cursoId) {
      return !('portadaKey' in datos)
        || (datos.portadaKey is string
          && datos.portadaKey.matches('^portadas/' + cursoId + '$'));
    }

    function cursoValido(datos, cursoId) {
      return idValido(cursoId)
        && datos.keys().hasAll([
          'nombre', 'descripcion', 'categoriaId', 'nivel', 'publicado',
          'acceso', 'creadoEn', 'actualizadoEn', 'creadoPor'
        ])
        && datos.keys().hasOnly([
          'nombre', 'descripcion', 'categoriaId', 'nivel', 'publicado',
          'acceso', 'portadaKey', 'creadoEn', 'actualizadoEn', 'creadoPor'
        ])
        && textoValido(datos.nombre, 2, 120)
        && textoValido(datos.descripcion, 0, 2000)
        && idValido(datos.categoriaId)
        && datos.nivel in ['basico', 'intermedio', 'avanzado']
        && datos.publicado is bool
        && datos.acceso in ['gratis', 'premium']
        && portadaValida(datos, cursoId)
        && datos.creadoEn is timestamp
        && datos.actualizadoEn == request.time
        && textoValido(datos.creadoPor, 1, 128);
    }

    function claseValida(datos) {
      return datos.keys().hasAll([
          'nombre', 'descripcion', 'orden', 'publicado', 'creadoEn',
          'actualizadoEn', 'creadoPor'
        ])
        && datos.keys().hasOnly([
          'nombre', 'descripcion', 'orden', 'publicado', 'creadoEn',
          'actualizadoEn', 'creadoPor'
        ])
        && textoValido(datos.nombre, 2, 120)
        && textoValido(datos.descripcion, 0, 2000)
        && datos.orden is int
        && datos.orden >= 0
        && datos.orden <= 10000
        && datos.publicado is bool
        && datos.creadoEn is timestamp
        && datos.actualizadoEn == request.time
        && textoValido(datos.creadoPor, 1, 128);
    }

    // `ruta` es el archivo dentro de la biblioteca de SharePoint; la función obtenerVideo la valida de nuevo antes de usarla.
    function contenidoValido(datos) {
      return datos.keys().hasAll([
          'nombre', 'tipo', 'ruta', 'orden', 'acceso', 'creadoEn', 'actualizadoEn'
        ])
        && datos.keys().hasOnly([
          'nombre', 'tipo', 'ruta', 'orden', 'acceso', 'creadoEn', 'actualizadoEn'
        ])
        && textoValido(datos.nombre, 2, 160)
        && datos.tipo in ['video', 'documento']
        && textoValido(datos.ruta, 1, 300)
        && datos.orden is int
        && datos.orden >= 0
        && datos.orden <= 10000
        && datos.acceso in ['gratis', 'premium']
        && datos.creadoEn is timestamp
        && datos.actualizadoEn == request.time;
    }

    function rutaExamen(examenId) {
      return /databases/$(database)/documents/examenes/$(examenId);
    }

    // Las notas van de 0 a 20. Las preguntas no se validan una a una: solo las escribe un administrador.
    function examenValido(datos) {
      return datos.keys().hasAll([
          'cursoId', 'nombre', 'descripcion', 'modo', 'duracionMin', 'notaMinima',
          'publicado', 'preguntas', 'creadoEn', 'actualizadoEn', 'creadoPor'
        ])
        && datos.keys().hasOnly([
          'cursoId', 'nombre', 'descripcion', 'modo', 'duracionMin', 'notaMinima',
          'publicado', 'preguntas', 'creadoEn', 'actualizadoEn', 'creadoPor', 'herramientas'
        ])
        && idValido(datos.cursoId)
        && textoValido(datos.nombre, 2, 120)
        && textoValido(datos.descripcion, 0, 2000)
        && datos.modo in ['manual', 'archivo']
        && datos.duracionMin is int
        && datos.duracionMin >= 0
        && datos.duracionMin <= 480
        && datos.notaMinima is number
        && datos.notaMinima >= 0
        && datos.notaMinima <= 20
        && datos.publicado is bool
        && (!('herramientas' in datos) || datos.herramientas is bool)
        && datos.preguntas is list
        && datos.preguntas.size() <= 100
        && (datos.modo == 'archivo' || datos.preguntas.size() >= 1)
        && datos.creadoEn is timestamp
        && datos.actualizadoEn == request.time
        && textoValido(datos.creadoPor, 1, 128);
    }

    // Un examen se puede rendir si está publicado, su curso también y el alumno tiene acceso al curso.
    function examenDisponible(examenId, cursoId) {
      return exists(rutaExamen(examenId))
        && exists(rutaCurso(cursoId))
        && get(rutaExamen(examenId)).data.publicado == true
        && get(rutaExamen(examenId)).data.modo == 'manual'
        && get(rutaExamen(examenId)).data.cursoId == cursoId
        && get(rutaCurso(cursoId)).data.publicado == true
        && (get(rutaCurso(cursoId)).data.acceso == 'gratis' || tienePlanPremium());
    }

    function intentoInicialValido(datos, intentoId) {
      return datos.keys().hasAll([
          'examenId', 'cursoId', 'uid', 'nombre', 'correo', 'inicio', 'fin',
          'estado', 'respuestas', 'nota', 'actualizadoEn'
        ])
        && datos.keys().hasOnly([
          'examenId', 'cursoId', 'uid', 'nombre', 'correo', 'inicio', 'fin',
          'estado', 'respuestas', 'nota', 'actualizadoEn'
        ])
        && idValido(datos.examenId)
        && idValido(datos.cursoId)
        && intentoId == datos.examenId + '_' + request.auth.uid
        && datos.uid == request.auth.uid
        && datos.correo == request.auth.token.email
        && datos.nombre == perfilActual().nombre
        && datos.inicio == request.time
        && datos.fin == null
        && datos.estado == 'en_curso'
        && datos.respuestas is map
        && datos.respuestas.size() == 0
        && datos.nota == null
        && datos.actualizadoEn == request.time
        && examenDisponible(datos.examenId, datos.cursoId);
    }

    // Margen de un minuto sobre el tiempo del examen para absorber la latencia de red.
    function dentroDelTiempo(intento) {
      return get(rutaExamen(intento.examenId)).data.duracionMin == 0
        || request.time <= intento.inicio
          + duration.value(get(rutaExamen(intento.examenId)).data.duracionMin + 1, 'm');
    }

    function notificacionValida(datos) {
      return datos.keys().hasAll(['titulo', 'texto', 'enlace', 'leida', 'creadoEn'])
        && datos.keys().hasOnly(['titulo', 'texto', 'enlace', 'leida', 'creadoEn'])
        && textoValido(datos.titulo, 1, 120)
        && textoValido(datos.texto, 0, 300)
        && textoValido(datos.enlace, 0, 200)
        && datos.leida == false
        && datos.creadoEn == request.time;
    }

    function ticketMensajeValido(mensaje, de) {
      return mensaje is map
        && mensaje.keys().hasAll(['de', 'autor', 'texto', 'fecha'])
        && mensaje.keys().hasOnly(['de', 'autor', 'texto', 'fecha'])
        && mensaje.de == de
        && textoValido(mensaje.autor, 1, 120)
        && textoValido(mensaje.texto, 1, 2000)
        && mensaje.fecha is number;
    }

    function ticketNuevoValido(datos) {
      return datos.keys().hasAll([
          'uid', 'nombre', 'correo', 'rol', 'asunto', 'categoria', 'estado',
          'mensajes', 'sinLeer', 'creadoEn', 'actualizadoEn'
        ])
        && datos.keys().hasOnly([
          'uid', 'nombre', 'correo', 'rol', 'asunto', 'categoria', 'estado',
          'mensajes', 'sinLeer', 'creadoEn', 'actualizadoEn'
        ])
        && datos.uid == request.auth.uid
        && datos.nombre == perfilActual().nombre
        && datos.correo == perfilActual().correo
        && datos.rol == perfilActual().rol
        && textoValido(datos.asunto, 3, 100)
        && datos.categoria in ['Cursos', 'Exámenes', 'Herramientas', 'Pagos y planes', 'Mi cuenta', 'Otro']
        && datos.estado == 'abierto'
        && datos.sinLeer == false
        && datos.mensajes is list
        && datos.mensajes.size() == 1
        && ticketMensajeValido(datos.mensajes[0], 'usuario')
        && datos.creadoEn == request.time
        && datos.actualizadoEn == request.time;
    }

    // Una sola respuesta nueva al final; los mensajes anteriores no cambian.
    function ticketConMensajeNuevo(de) {
      let antes = resource.data.mensajes;
      let despues = request.resource.data.mensajes;
      return despues is list
        && despues.size() == antes.size() + 1
        && despues.size() <= 200
        && despues[0:antes.size()] == antes
        && ticketMensajeValido(despues[despues.size() - 1], de);
    }

    function progresoValido(datos, progresoId) {
      return datos.keys().hasAll([
          'cursoId', 'claseId', 'completado', 'completadoEn', 'actualizadoEn'
        ])
        && datos.keys().hasOnly([
          'cursoId', 'claseId', 'completado', 'completadoEn', 'actualizadoEn'
        ])
        && idValido(datos.cursoId)
        && idValido(datos.claseId)
        && progresoId == datos.cursoId + '_' + datos.claseId
        && datos.completado is bool
        && ((datos.completado == true && datos.completadoEn == request.time)
          || (datos.completado == false && datos.completadoEn == null))
        && datos.actualizadoEn == request.time
        && cursoPublicado(datos.cursoId)
        && clasePublicada(datos.cursoId, datos.claseId);
    }

    match /usuarios/{uid} {
      // El dueño lee su perfil (también sin verificar el correo); el admin lista a los alumnos.
      allow get: if esPropietario(uid) || esAdministrador();
      allow list: if esAdministrador();

      // El registro crea siempre un alumno gratis, incluso antes de verificar el correo.
      allow create: if esPropietario(uid)
        && perfilValido(request.resource.data)
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.rol == 'alumno'
        && request.resource.data.plan == 'gratis'
        && request.resource.data.get('estado', 'activo') == 'activo'
        && request.resource.data.creadoEn == request.time;

      // El dueño solo puede cambiar su nombre y su foto; rol y plan requieren un proceso confiable.
      allow update: if esPropietario(uid)
        && perfilValido(request.resource.data)
        && request.resource.data.correo == resource.data.correo
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'foto']);

      // El admin solo gestiona plan y estado; el rol se cambia fuera de la app.
      allow update: if esAdministrador()
        && perfilValido(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'estado']);

      allow delete: if false;

      match /progreso/{progresoId} {
        allow get, list: if (esPropietario(uid) && esAlumnoVerificado()) || esAdministrador();

        // Solo registra avance quien está inscrito en el curso.
        allow create: if esPropietario(uid)
          && esAlumnoVerificado()
          && progresoValido(request.resource.data, progresoId)
          && exists(/databases/$(database)/documents/usuarios/$(uid)/inscripciones/$(request.resource.data.cursoId));

        allow update: if esPropietario(uid)
          && esAlumnoVerificado()
          && progresoValido(request.resource.data, progresoId)
          && request.resource.data.cursoId == resource.data.cursoId
          && request.resource.data.claseId == resource.data.claseId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completado', 'completadoEn', 'actualizadoEn']);

        allow delete: if false;
      }

      // Las crea el administrador (por ejemplo, al publicar una nota); el alumno solo las marca como leídas.
      match /notificaciones/{notificacionId} {
        allow get, list: if esPropietario(uid) && esAlumnoVerificado();

        allow create: if esAdministrador() && notificacionValida(request.resource.data);

        allow update: if esPropietario(uid)
          && esAlumnoVerificado()
          && request.resource.data.leida is bool
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);

        allow delete: if false;
      }

      // Inscripción en un curso publicado; un curso premium exige el plan premium.
      match /inscripciones/{cursoId} {
        allow get, list: if (esPropietario(uid) && esAlumnoVerificado()) || esAdministrador();

        allow create: if esPropietario(uid)
          && esAlumnoVerificado()
          && idValido(cursoId)
          && request.resource.data.keys().hasAll(['cursoId', 'inscritoEn'])
          && request.resource.data.keys().hasOnly(['cursoId', 'inscritoEn'])
          && request.resource.data.cursoId == cursoId
          && request.resource.data.inscritoEn == request.time
          && cursoPublicado(cursoId)
          && (get(rutaCurso(cursoId)).data.acceso == 'gratis' || tienePlanPremium());

        allow update, delete: if false;
      }
    }

    // Consulta de grupo del administrador para contar los inscritos de cada curso.
    match /{ruta=**}/inscripciones/{cursoId} {
      allow list: if esAdministrador();
    }

    match /categorias/{categoriaId} {
      allow get, list: if esAdministrador()
        || (esAlumnoVerificado() && resource.data.activa == true);

      allow create: if esAdministrador()
        && categoriaValida(request.resource.data)
        && request.resource.data.creadoEn == request.time;

      allow update: if esAdministrador()
        && categoriaValida(request.resource.data)
        && request.resource.data.creadoEn == resource.data.creadoEn;

      allow delete: if esAdministrador();
    }

    match /cursos/{cursoId} {
      // El catálogo muestra cursos premium; el contenido se protege por separado.
      allow get, list: if esAdministrador()
        || (esAlumnoVerificado() && resource.data.publicado == true);

      allow create: if esAdministrador()
        && cursoValido(request.resource.data, cursoId)
        && categoriaActiva(request.resource.data.categoriaId)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time;

      // Una categoría desactivada no bloquea editar sus cursos; solo se exige al moverlos a otra.
      allow update: if esAdministrador()
        && cursoValido(request.resource.data, cursoId)
        && (request.resource.data.categoriaId == resource.data.categoriaId
          || categoriaActiva(request.resource.data.categoriaId))
        && request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.creadoPor == resource.data.creadoPor;

      allow delete: if esAdministrador();

      match /clases/{claseId} {
        allow get, list: if esAdministrador()
          || (esAlumnoVerificado()
            && cursoPublicado(cursoId)
            && resource.data.publicado == true);

        allow create: if esAdministrador()
          && idValido(claseId)
          && exists(rutaCurso(cursoId))
          && claseValida(request.resource.data)
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.creadoEn == request.time;

        allow update: if esAdministrador()
          && idValido(claseId)
          && exists(rutaCurso(cursoId))
          && claseValida(request.resource.data)
          && request.resource.data.creadoEn == resource.data.creadoEn
          && request.resource.data.creadoPor == resource.data.creadoPor;

        allow delete: if esAdministrador();

        // Los alumnos no leen contenidos desde el navegador: la función obtenerVideo entrega el video solo si su plan lo permite.
        match /contenidos/{contenidoId} {
          allow get, list: if esAdministrador();

          allow create: if esAdministrador()
            && idValido(cursoId)
            && idValido(claseId)
            && idValido(contenidoId)
            && exists(rutaCurso(cursoId))
            && exists(rutaClase(cursoId, claseId))
            && contenidoValido(request.resource.data)
            && request.resource.data.creadoEn == request.time;

          allow update: if esAdministrador()
            && idValido(cursoId)
            && idValido(claseId)
            && idValido(contenidoId)
            && exists(rutaCurso(cursoId))
            && exists(rutaClase(cursoId, claseId))
            && contenidoValido(request.resource.data)
            && request.resource.data.creadoEn == resource.data.creadoEn;

          allow delete: if esAdministrador();
        }
      }
    }

    match /examenes/{examenId} {
      // La lista muestra cursos premium; rendir el examen exige acceso al curso (ver intentos).
      allow get, list: if esAdministrador()
        || (esAlumnoVerificado() && resource.data.publicado == true);

      allow create: if esAdministrador()
        && idValido(examenId)
        && examenValido(request.resource.data)
        && exists(rutaCurso(request.resource.data.cursoId))
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time;

      allow update: if esAdministrador()
        && examenValido(request.resource.data)
        && request.resource.data.cursoId == resource.data.cursoId
        && request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.creadoPor == resource.data.creadoPor;

      allow delete: if esAdministrador();

      // Respuestas correctas: nunca se leen desde el navegador del alumno.
      match /claves/{claveId} {
        allow read, delete: if esAdministrador();

        allow create, update: if esAdministrador()
          && claveId == 'clave'
          && request.resource.data.keys().hasOnly(['respuestas', 'actualizadoEn'])
          && request.resource.data.respuestas is map
          && request.resource.data.actualizadoEn == request.time;
      }
    }

    match /intentos/{intentoId} {
      allow get, list: if esAdministrador()
        || (esAlumnoVerificado() && resource.data.uid == request.auth.uid);

      // Un intento por examen: el ID es examenId_uid y empieza al abrir el examen.
      allow create: if esAlumnoVerificado()
        && intentoInicialValido(request.resource.data, intentoId);

      // El alumno guarda respuestas y entrega mientras corre el tiempo.
      allow update: if esAlumnoVerificado()
        && resource.data.uid == request.auth.uid
        && resource.data.estado == 'en_curso'
        && request.resource.data.estado in ['en_curso', 'entregado']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['respuestas', 'estado', 'fin', 'actualizadoEn'])
        && request.resource.data.respuestas is map
        && request.resource.data.respuestas.size() <= 100
        && request.resource.data.actualizadoEn == request.time
        && ((request.resource.data.estado == 'en_curso' && request.resource.data.fin == null)
          || (request.resource.data.estado == 'entregado' && request.resource.data.fin == request.time))
        && dentroDelTiempo(resource.data);

      // El administrador califica (o recalifica) y puede borrar un intento para que el alumno rinda de nuevo.
      allow update: if esAdministrador()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nota', 'puntajes', 'comentario', 'estado', 'calificadoEn', 'actualizadoEn'])
        && request.resource.data.estado == 'calificado'
        && request.resource.data.nota is number
        && request.resource.data.nota >= 0
        && request.resource.data.nota <= 20
        && request.resource.data.puntajes is map
        && textoValido(request.resource.data.comentario, 0, 1000)
        && request.resource.data.calificadoEn == request.time
        && request.resource.data.actualizadoEn == request.time;

      allow delete: if esAdministrador();
    }

    match /tickets/{ticketId} {
      allow get, list: if esAdministrador()
        || (perfilActivo() && resource.data.uid == request.auth.uid);

      // Cualquier usuario activo, alumno o administrador, abre tickets a su nombre.
      allow create: if perfilActivo() && ticketNuevoValido(request.resource.data);

      // El dueño agrega un mensaje mientras el ticket siga abierto.
      allow update: if perfilActivo()
        && resource.data.uid == request.auth.uid
        && resource.data.estado != 'cerrado'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mensajes', 'estado', 'actualizadoEn'])
        && request.resource.data.estado == 'abierto'
        && ticketConMensajeNuevo('usuario')
        && request.resource.data.actualizadoEn == request.time;

      // El dueño marca la respuesta como leída o cierra su ticket.
      allow update: if perfilActivo()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sinLeer'])
        && request.resource.data.sinLeer == false;

      allow update: if perfilActivo()
        && resource.data.uid == request.auth.uid
        && resource.data.estado != 'cerrado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEn'])
        && request.resource.data.estado == 'cerrado'
        && request.resource.data.actualizadoEn == request.time;

      // Soporte responde (deja el ticket como respondido y avisa al dueño).
      allow update: if esAdministrador()
        && resource.data.estado != 'cerrado'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mensajes', 'estado', 'sinLeer', 'actualizadoEn'])
        && request.resource.data.estado == 'respondido'
        && request.resource.data.sinLeer == true
        && ticketConMensajeNuevo('soporte')
        && request.resource.data.actualizadoEn == request.time;

      // Soporte cierra o reabre.
      allow update: if esAdministrador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEn'])
        && request.resource.data.estado in ['abierto', 'cerrado']
        && request.resource.data.actualizadoEn == request.time;

      allow delete: if false;
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
