ell><mxCell id="d1-s5" value="Hoy la calificación corre en el navegador del administrador. Pasarla a una Cloud Function está pendiente." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C00000;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="440" y="744" width="290" height="56" as="geometry"/></mxCell><mxCell id="d1-e3" value="1. Abrir el examen" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="113" as="sourcePoint"/><mxPoint x="280" y="113" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e4" value="2. crear intento examenId_uid&lt;br&gt;(en_curso, inicio = hora del servidor)" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="181" as="sourcePoint"/><mxPoint x="510" y="181" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e5" value="3. aceptado si el examen y el curso están publicados,&lt;br&gt;hay acceso y es el único intento" style="html=1;rounded=0;endArrow=open;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="249" as="sourcePoint"/><mxPoint x="280" y="249" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e6" value="4. guardar respuestas en cada cambio" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="302" as="sourcePoint"/><mxPoint x="510" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e7" value="5. Entregar (o se agota el tiempo)" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="355" as="sourcePoint"/><mxPoint x="280" y="355" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e8" value="6. estado = entregado, fin = hora del servidor&lt;br&gt;(solo dentro de la duración + 1 minuto)" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="423" as="sourcePoint"/><mxPoint x="510" y="423" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e9" value="7. Abrir Entregas y calificar" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="476" as="sourcePoint"/><mxPoint x="280" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e10" value="8. leer examenes/{id}/claves/clave&lt;br&gt;(solo administradores)" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="544" as="sourcePoint"/><mxPoint x="510" y="544" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e11" value="9. clave de respuestas" style="html=1;rounded=0;endArrow=open;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="597" as="sourcePoint"/><mxPoint x="280" y="597" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e12" value="10. guardar nota 0–20, puntajes y estado = calificado,&lt;br&gt;más la notificación del alumno (mismo lote)" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="665" as="sourcePoint"/><mxPoint x="510" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e13" value="11. aviso en la campana: nota y comentarios" style="html=1;rounded=0;endArrow=open;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="718" as="sourcePoint"/><mxPoint x="70" y="718" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>