<mxfile host="app.diagrams.net" agent="Noova Learn Mining" version="24.7.0" type="device"><diagram id="d1" name="5. Secuencia: video de una clase"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="901" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1-alu" value="Alumno" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;fillColor=#E3EEF3;strokeColor=#075570;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="5.0" y="16" width="130" height="865" as="geometry"/></mxCell><mxCell id="d1-app" value="Aplicación web" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;fillColor=#E3EEF3;strokeColor=#075570;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="175.0" y="16" width="130" height="865" as="geometry"/></mxCell><mxCell id="d1-fs" value="Cloud Firestore" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;fillColor=#E3EEF3;strokeColor=#075570;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="365.0" y="16" width="130" height="865" as="geometry"/></mxCell><mxCell id="d1-fn" value="Función obtenerVideo" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;fillColor=#E3EEF3;strokeColor=#075570;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="555.0" y="16" width="130" height="865" as="geometry"/></mxCell><mxCell id="d1-sp" value="SharePoint (Graph)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;fillColor=#E3EEF3;strokeColor=#075570;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="735.0" y="16" width="130" height="865" as="geometry"/></mxCell><mxCell id="d1-s6" value="La función valida: correo verificado, rol alumno, cuenta activa, curso y clase publicados, inscripción y plan (premium si el curso o el video lo piden)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=11;fillColor=#FFFBE6;strokeColor=#8A8A8A;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="500" y="449" width="250" height="92" as="geometry"/></mxCell><mxCell id="d1-s7" value="Si el plan no alcanza, la función responde permission-denied y la página muestra los planes Premium." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C00000;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="799" width="340" height="56" as="geometry"/></mxCell><mxCell id="d1-e3" value="1. Abrir una clase" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="113" as="sourcePoint"/><mxPoint x="240" y="113" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d1-e4" value="2. leer clase y avance&lt;br&gt;(reglas: debe estar inscrito)" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="181" as="sourcePoint"/><mxPoint x="430" y="181" as="targetPoint"/></mxGeometry></mxCell><mxCel